PORT=2130
NODE_ENV=development
DATABASE=
KEY=
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:2130,http://127.0.0.1:2130

API_K=
GEMINI_KEY=
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIMENSIONS=768
GEMINI_ANALYSE_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.7

PINE_CONE=
PINECONE_INDEX=chatgpt

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.3

TAVILY_API_KEY=
WEATHER_API_KEY=
WEATHER_API_URL=https://api.weatherapi.com/v1/current.json
NEWS_API_KEY=
NEWS_API_URL=https://newsapi.org/v2/everything

GMAIL_USER=
GMAIL_PASS=
# Free Gmail API path for hosts that block SMTP, including Render.
# Create a free OAuth client, then run: npm run gmail-auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# Render blocks ports 25, 465, and 587. Leave SMTP_ENABLED unset there.
# Set it to true only on a host that allows outbound SMTP.
SMTP_ENABLED=
MAIL_FROM_NAME=Astra AI
RESEND_API_KEY=
# Address on a domain verified in Resend. onboarding@resend.dev does not deliver.
RESEND_FROM=
# Optional HTTPS sender. Confirm BREVO_SENDER in Brevo, then set both.
BREVO_API_KEY=
BREVO_SENDER=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
APP_URL=

REFILL_RATE=1
CAPACITY=5
